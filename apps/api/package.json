    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "node ../../scripts/test.mjs"
  },
  "dependencies": {
    "@douban-bridge/contracts": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
