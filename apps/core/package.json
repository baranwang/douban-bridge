    "@octokit/core": "^7.0.8",
    "@octokit/oauth-app": "^8.0.4",
    "@tanstack/react-form": "^1.33.5",
    "@trakt/api": "npm:@jsr/trakt__api@^0.5.4",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.7",
    "liquidjs": "^10.29.0",
    "lucide-react": "^1.45.0",
    "p-limit": "^7.3.2",
    "path-to-regexp": "^8.4.2",
