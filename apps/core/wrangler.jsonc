{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douban-bridge-core",
  "main": "./src/index.tsx",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2025-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "douban-bridge.baran.wang",
      "custom_domain": true
    }
  ],
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "STREMIO_ADDON_DOUBAN",
      "database_name": "stremio-addon-douban",
      "database_id": "543ed1d5-3da8-4ed1-8084-25084af52953",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8274189206e84436bf11f861debd918a",
      "remote": false
    }
  ],
  "vars": {
    "DOUBAN_API_KEY": "0ac44ae016490db2204ce0a042db2916",
    "TRAKT_CLIENT_ID": "95pidRr4d15bGI__HJQtIsSRzv_GfTnznlFotZrFsew",
    "GITHUB_CLIENT_ID": "Ov23liAcIeCqxTwANWoZ",
    "STREMIO_ORIGIN": "https://stremio-addon-douban.baran.wang",
    "DASH_ORIGIN": "https://douban-bridge.baran.wang",
    "AGENT_MATCH_MODEL": "grok-4.6",
    "AGENT_MATCH_GATEWAY_ID": "default",
    "AGENT_MATCH_GATEWAY_PROVIDER": "carpool"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "USER_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [{ "binding": "AGENT_MATCH_QUEUE", "queue": "douban-agent-match" }],
    "consumers": [{
      "queue": "douban-agent-match",
      "max_batch_size": 1,
      "max_concurrency": 1
    }]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
