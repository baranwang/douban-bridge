{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "douban-bridge-core-test",
  "main": "./src/index.tsx",
  "compatibility_date": "2025-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "STREMIO_ADDON_DOUBAN",
      "database_name": "douban-bridge-core-test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    "JWT_SECRET": "local-test-only-secret",
    "STREMIO_ORIGIN": "https://stremio-addon-douban.baran.wang",
    "DASH_ORIGIN": "https://douban-bridge.baran.wang",
    "GITHUB_CLIENT_ID": "stremio-gh-id",
    "AGENT_MATCH_BASE_URL": "https://example.invalid/v1",
    "AGENT_MATCH_MODEL": "test-model",
    "AGENT_MATCH_API_KEY": "test-key"
  }
}
