{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stremio-addon-douban",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8788 },
  "routes": [{ "pattern": "stremio-addon-douban.baran.wang", "custom_domain": true }],
  "services": [
    { "binding": "CORE_STREMIO", "service": "douban-bridge-core", "entrypoint": "StremioEntrypoint", "remote": false },
    { "binding": "CORE_WEB", "service": "douban-bridge-core", "remote": false }
  ],
  "ratelimits": [
    { "name": "PUBLIC_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "USER_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
