{
  "name": "stremio-addon-douban",
  "displayName": "Douban",
  "description": "Douban addon for Stremio",
  "type": "module",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @douban-bridge/core dev",
    "build": "turbo build",
    "preview": "pnpm --filter @douban-bridge/core preview",
    "deploy": "pnpm build && pnpm --filter @douban-bridge/core deploy",
    "cf-typegen": "turbo cf-typegen",
    "test": "turbo test",
    "smoke": "node scripts/smoke.mjs",
    "change": "changeset",
    "version": "changeset version",
    "postversion": "pnpm --filter @rexnow/douban build",
    "prerelease": "pnpm --filter @rexnow/douban build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "wrangler": "^4.131.1"
  }
}
